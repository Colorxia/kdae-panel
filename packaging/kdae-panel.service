[Unit]
Description=kdae-panel Web Management Service
Documentation=https://github.com/tuoro/kdae-panel
After=network-online.target dae.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/kdae-panel/kdae-panel.env
ExecStart=/usr/bin/kdae-panel
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=15s
UMask=0077

# 面板需要管理 dae、写入配置并通过 systemd 控制服务；其余系统面尽量收紧。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
# sysdump 需要读取 /proc/sys/net；ProtectProc 仍会隐藏其他进程。
ProcSubset=all
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_KILL CAP_NET_ADMIN
AmbientCapabilities=CAP_KILL CAP_NET_ADMIN
ReadWritePaths=/etc/dae /var/lib/kdae-panel
# 启用 KDAE_PANEL_ENABLE_DAE_INSTALL 时，还需要让面板能写入 dae 可执行文件
# 所在目录，请按 systemctl show dae --property=ExecStart 的实际路径追加，例如：
#   ReadWritePaths=/usr/bin
# 若还要用面板完成 dae 的首次安装，再加上服务单元目录：
#   ReadWritePaths=/etc/systemd/system
# 前者在 root 的 PATH 上，后者能定义以 root 运行的服务；开放任一个都意味着
# 面板的缺陷可能升级为任意代码执行，因此默认都不开。
# geo 数据写在配置目录（/etc/dae），已被上面覆盖，无需额外放宽。

[Install]
WantedBy=multi-user.target
